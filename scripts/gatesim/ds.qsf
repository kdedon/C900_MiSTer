set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY disk_stream
set_global_assignment -name SYSTEMVERILOG_FILE fd_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE disk_stream.sv
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY .
set_parameter -name UMAX 136
set_parameter -name NFMT 4
set_parameter -name QUIET 20000

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST ON -section_id eda_simulation