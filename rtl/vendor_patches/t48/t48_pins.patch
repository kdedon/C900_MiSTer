+      end if;
+
+      -- XTAL1 fall after the end of XTAL3
+      if xtal_fall_en_i and xtal_q = 0 then
+        case mstate_q is
+          -- ALE is removed in State 5 of every machine cycle
+          when MSTATE5 =>
+            ale_q    <= false;
